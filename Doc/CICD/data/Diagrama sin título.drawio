          <mxGeometry x="490" y="660" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- Compuerta: build develop OK? -->
        <mxCell id="gate-build-dev" parent="1"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;"
